{
  "name": "antigravity-sidecar-kit",
  "version": "1.0.3",
  "type": "module",
  "description": "Zero-dependency SDK and CLI scaffolder for Google Antigravity Auxiliary Pane sidecars (Connect RPC client, host theme & Tailwind proxy, BOM-safe config store, workspace URI matcher, and npx-safe installer).",
  "license": "MIT",
  "author": {
    "name": "Arthur Cavallari",
    "url": "https://github.com/arthurcavallari"
  },
  "homepage": "https://github.com/arthurcavallari/antigravity-sidecar-kit#readme",
  "bugs": {
    "url": "https://github.com/arthurcavallari/antigravity-sidecar-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurcavallari/antigravity-sidecar-kit.git"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./config": "./lib/config.mjs",
    "./rpc": "./lib/rpc.mjs",
    "./theme": "./lib/theme.mjs",
    "./setup": "./lib/setup.mjs",
    "./server": "./lib/server.mjs",
    "./workspace": "./lib/workspace.mjs",
    "./scaffolder": "./lib/scaffolder.mjs",
    "./cli": "./bin/cli.mjs"
  },
  "bin": {
    "antigravity-sidecar-kit": "bin/cli.mjs",
    "create-antigravity-sidecar": "bin/cli.mjs",
    "agy-sidecar-kit": "bin/cli.mjs"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "agy",
    "antigravity-sidecar",
    "antigravity-plugin",
    "sidecar",
    "sdk",
    "hangar"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:pack": "node scripts/pack-smoke.mjs && node scripts/pack-smoke-create.mjs"
  }
}
